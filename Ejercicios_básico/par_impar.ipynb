    "Escribe un programa que pida un número y determine si es par o impar."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "36 es par.\n"
     ]
    }
   ],
   "source": [
    "numero = int(input(\"Introduce un número\"))\n",
    "\n",
    "if numero % 2==0: \n",
    "    print (f\"{numero} es par.\")\n",
    "else:\n",
    "    print(f\"{numero} es impar\")\n",
    "    "
