   "source": [
    "# Reversa de una cadena\n",
    "Pide al usuario una palabra y muestra la palabra al revés."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "La palabra del revés es la siguiente: aloh\n"
     ]
    }
   ],
   "source": [
    "palabra = input (\"Introduce una palabra, por favor.\")\n",
    "\n",
    "palabra_reves = palabra[::-1]\n",
    "\n",
    "print (f\"La palabra del revés es la siguiente: {palabra_reves}\")"
   ]
  }
